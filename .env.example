# Public product identity
APP_NAME=Balance
PRODUCT_NAME=Balance
PROJECT_SLUG=balance

# Infrastructure namespace
DEPLOYMENT_NAMESPACE=balance

# Local runtime defaults
APP_ENV=local
NODE_ENV=development
APP_VERSION=0.6.0
GIT_COMMIT=local
BUILD_ID=local-build
WEB_PORT=3000
API_PORT=3001
PUBLIC_HTTP_PORT=3000
# In Docker Compose, web proxies to the internal API service over the Compose network.
API_BASE_URL=http://api:3001
API_PROXY_TARGET=http://api:3001
DESKTOP_API_BASE_URL=http://localhost:3000/api
API_BASE_PATH=/api
API_HEALTH_PATH=/api/health
API_VERSION_PATH=/api/version
NEXT_PUBLIC_API_BASE_PATH=/api
NEXT_PUBLIC_API_HEALTH_PATH=/api/health
NEXT_PUBLIC_API_VERSION_PATH=/api/version
NEXT_PUBLIC_WEB_CLIENT_TELEMETRY_ENABLED=true

# Browser/API security
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
API_CORS_ORIGINS=
EXTERNAL_WEB_ORIGIN=http://localhost:3000
API_JSON_BODY_LIMIT=1mb
API_URLENCODED_BODY_LIMIT=100kb
AUTH_DEV_EXPOSE_ACCOUNT_TOKENS=false
AUTH_SELF_REGISTRATION_ENABLED=true
AUTH_ACCOUNT_TOKEN_RETENTION_DAYS=7
COOKIE_SECURE=false
TRUST_PROXY=false

# Database and queue (placeholders only)
DATABASE_URL=postgresql://balance:balance@postgres:5432/balance?schema=public
POSTGRES_USER=balance
POSTGRES_PASSWORD=balance
POSTGRES_DB=balance
REDIS_URL=redis://redis:6379
QUEUE_PROOF_NAME=queue_proof
EXTRACTION_QUEUE_NAME=document_extract

# OCR (placeholders only)
OCR_PROVIDER=paddleocr
OCR_ENABLE_TESSERACT_FALLBACK=true
TESSERACT_LANG=eng
EXTRACTION_PROVIDER_DEFAULT=paddleocr
EXTRACTION_ALLOW_LEGACY_TEXTRACT=false
PDF_OCR_DPI=300
OCR_MAX_PAGES_LOCAL=3
OCR_MAX_IMAGE_PIXELS=50000000

# Storage (placeholders only)
OBJECT_STORAGE_PROVIDER=filesystem
OBJECT_STORAGE_FILESYSTEM_ROOT=/data/balance-storage
STORAGE_DRIVER=filesystem
STORAGE_FILESYSTEM_ROOT=/data/balance-storage

# Seed (placeholders only; do not commit real passwords)
SEED_CONSUMER_PASSWORD=replace-this-local-only
SEED_STAFF_PASSWORD=replace-this-local-only
SEED_REVIEWER_PASSWORD=replace-this-local-only
SEED_ADMIN_PASSWORD=replace-this-local-only
SEED_SYSTEM_ADMIN_PASSWORD=replace-this-local-only
# Smoke seed is staging-only and requires this exact confirmation value.
SEED_SMOKE_CONFIRM=

# Observability (local-only placeholder)
API_OTEL_ENABLED=true
API_PROFILING_ENABLED=true
OTEL_SERVICE_NAME=balance-api
OTEL_EXPORTER_OTLP_ENDPOINT=http://alloy:4318
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://alloy:4318/v1/traces
OTEL_EXPORTER_OTLP_LOGS_ENDPOINT=http://alloy:4318/v1/logs
PYROSCOPE_SERVER_ADDRESS=http://pyroscope:4040
WORKER_OTEL_ENABLED=true
WORKER_PROFILING_ENABLED=true
WORKER_OTEL_SERVICE_NAME=balance-worker
WEB_OTEL_ENABLED=true
WEB_PROFILING_ENABLED=true
WEB_CLIENT_TELEMETRY_ENABLED=true
WEB_INTERNAL_METRICS_ENABLED=true
WEB_INTERNAL_METRICS_HOSTS=web:3000
WEB_OTEL_SERVICE_NAME=balance-web
GRAFANA_ADMIN_PASSWORD=change-me-for-local-only
GRAFANA_ADMIN_USER=admin
GRAFANA_ROOT_URL=http://127.0.0.1:3002
GRAFANA_COOKIE_SECURE=false
BALANCE_BASE_DOMAIN=localhost.localdomain
BALANCE_TLS_EMAIL=security@localhost.localdomain
# Production-profile Authelia secrets are intentionally blank in the example.
# Set strong local-only values before running the production profile.
AUTHELIA_SESSION_SECRET=
AUTHELIA_STORAGE_ENCRYPTION_KEY=
AUTHELIA_JWT_SECRET=
