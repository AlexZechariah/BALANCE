{
  "name": "@balance/api",
  "version": "0.6.0",
  "private": true,
  "scripts": {
    "build": "pnpm exec tsc -p tsconfig.build.json",
    "dev": "node --env-file=../../.env dist/main.js",
    "lint": "pnpm exec eslint -c ../../eslint.config.mjs src test --ext .ts",
    "start": "node dist/main.js",
    "typecheck": "pnpm exec tsc --noEmit -p tsconfig.json",
    "test": "pnpm exec vitest run test --no-file-parallelism"
  },
  "dependencies": {
    "@balance/config": "workspace:*",
    "@balance/db": "workspace:*",
    "@balance/schemas": "workspace:*",
    "@balance/types": "workspace:*",
    "@casl/ability": "7.0.0",
    "@casl/prisma": "2.0.1",
    "@nestjs/common": "11.1.24",
    "@nestjs/core": "11.1.24",
    "@nestjs/platform-express": "11.1.24",
    "@nestjs/throttler": "6.5.0",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/exporter-logs-otlp-http": "0.218.0",
    "@opentelemetry/exporter-trace-otlp-http": "0.218.0",
    "@opentelemetry/instrumentation-express": "0.66.0",
    "@opentelemetry/instrumentation-http": "0.218.0",
    "@opentelemetry/instrumentation-nestjs-core": "0.64.0",
    "@opentelemetry/instrumentation-pino": "0.64.0",
    "@opentelemetry/sdk-logs": "0.218.0",
    "@opentelemetry/sdk-node": "0.218.0",
    "@prisma/adapter-pg": "7.8.0",
    "@prisma/client": "7.8.0",
    "@prisma/instrumentation": "7.8.0",
    "@pyroscope/nodejs": "0.4.11",
    "argon2": "0.44.0",
    "bullmq": "5.77.6",
    "file-type": "22.0.1",
    "helmet": "8.2.0",
    "ioredis": "5.10.1",
    "pg": "8.20.0",
    "pino": "10.3.1",
    "prom-client": "15.1.3",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.1.5"
  },
  "devDependencies": {
    "@nestjs/testing": "11.1.24",
    "@types/express": "4.17.23",
    "@types/multer": "1.4.12",
    "@types/supertest": "6.0.3",
    "supertest": "7.2.2"
  }
