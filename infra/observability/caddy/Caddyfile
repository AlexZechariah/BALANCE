{
	admin off
	email {$BALANCE_TLS_EMAIL:security@localhost.localdomain}
}

status.{$BALANCE_BASE_DOMAIN:localhost.localdomain} {
	handle /metrics* {
		respond "Not Found" 404
	}

	handle {
		reverse_proxy gatus:8080
	}
}

auth.{$BALANCE_BASE_DOMAIN:localhost.localdomain} {
	reverse_proxy authelia:9091
}

grafana.{$BALANCE_BASE_DOMAIN:localhost.localdomain} {
	forward_auth authelia:9091 {
		uri /api/authz/forward-auth
		copy_headers Remote-User Remote-Groups Remote-Email Remote-Name
	}

	reverse_proxy grafana:3000
}

metrics.{$BALANCE_BASE_DOMAIN:localhost.localdomain}, logs.{$BALANCE_BASE_DOMAIN:localhost.localdomain} {
	respond "Not Found" 404
}
